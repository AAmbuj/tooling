# --- MODULE.bazel ------------------------------------------------------------

module(
    name = "<my_project>",
    version = "0.0.0",
)

# Pick the current version from the Eclipse S-CORE Bazel registry.
bazel_dep(name = "score_tooling", version = "<version>")

# Required by rules_score work products.
bazel_dep(name = "trlc", version = "3.0.0")
bazel_dep(name = "lobster", version = "1.0.4")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# LLVM toolchain: supplies both the C++ compiler and the libclang.so used by
# unit design validation.
bazel_dep(name = "toolchains_llvm", version = "1.6.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "19.1.7")
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# --- .bazelrc ----------------------------------------------------------------
#
# The S-CORE registry must be listed before the BCR.
#
#   common --registry=https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/
#   common --registry=https://bcr.bazel.build
#
#   common --extra_toolchains=//bazel/toolchains:my_libclang_toolchain
